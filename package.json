{
    "name": "toolmanager-root",
    "version": "1.0.0",
    "scripts": {
      "dev": "cd backend && node --watch src/server.js",
      "start": "cd backend && node src/server.js",
      "build": "cd backend && npm install && npx prisma generate",
      "migrate": "npx prisma migrate deploy",
      "fbuild": "cd frontend && npm install && npm vite build"
    },
    "engines": {
      "node": ">=18.0.0"
    }
  }